# Supabase — painel do projeto → Connect (ou Settings → API keys)
# https://supabase.com/dashboard/project/_?showConnect=true
#
# No Vercel: Project Settings → Environment Variables → Production.
# Não adicione service-role key: o app usa apenas a chave publicável.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (publishable key) — ou a antiga chave anônima (anon key),
# as duas funcionam.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
